{
  "name": "blog-platform",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:db": "docker compose -f infra/docker/compose.yaml up -d",
    "stop:db": "docker compose -f infra/docker/compose.yaml down",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:studio": "pnpm --filter api prisma:studio",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "typecheck:web": "pnpm --filter web typecheck",
    "dev:api": "pnpm --filter api start:dev",
    "build:api": "pnpm --filter api build",
    "lint:api": "pnpm --filter api lint",
    "typecheck:api": "pnpm --filter api typecheck",
    "test:api": "pnpm --filter api test",
    "test:watch:api": "pnpm --filter api test:watch",
    "test:e2e:api": "pnpm --filter api test:e2e",
    "format": "pnpm exec prettier . --write",
    "format:check": "pnpm exec prettier . --check"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
